WITH Traffic_Summary AS (
    SELECT
        dt.Peak_Hour,
        COUNT(*) AS Traffic_Observations
    FROM Fact_Traffic ft
    JOIN Dim_Time dt
        ON ft.Time_Key = dt.Time_Key
    GROUP BY
        dt.Peak_Hour
),

Accident_Summary AS (
    SELECT
        dt.Peak_Hour,
        COUNT(*) AS Accident_Count,
        SUM(fa.Casualties) AS Total_Casualties,

        SUM(
            CASE
                WHEN fa.Accident_Severity = 'Severe'
                THEN 1
                ELSE 0
            END
        ) AS Severe_Accidents,

        SUM(
            CASE
                WHEN fa.Accident_Severity = 'Fatal'
                THEN 1
                ELSE 0
            END
        ) AS Fatal_Accidents

    FROM Fact_Accident fa
    JOIN Dim_Time dt
        ON fa.Time_Key = dt.Time_Key
    WHERE fa.Date_Key IN (
        SELECT DISTINCT Date_Key
        FROM Fact_Traffic
    )
    GROUP BY
        dt.Peak_Hour
)

SELECT
    ts.Peak_Hour,

    ts.Traffic_Observations,

    COALESCE(a.Accident_Count, 0) AS Accident_Count,

    COALESCE(a.Total_Casualties, 0) AS Total_Casualties,

    ROUND(
        COALESCE(a.Accident_Count, 0) * 100.0
        / ts.Traffic_Observations,
        2
    ) AS Accidents_Per_100_Traffic_Observations,

    ROUND(
        COALESCE(a.Total_Casualties, 0) * 100.0
        / ts.Traffic_Observations,
        2
    ) AS Casualties_Per_100_Traffic_Observations,

    COALESCE(a.Severe_Accidents, 0) AS Severe_Accidents,

    COALESCE(a.Fatal_Accidents, 0) AS Fatal_Accidents,

    ROUND(
        CASE
            WHEN COALESCE(a.Accident_Count, 0) > 0
            THEN (
                COALESCE(a.Severe_Accidents, 0)
                + COALESCE(a.Fatal_Accidents, 0)
            ) * 100.0
            / a.Accident_Count
            ELSE 0
        END,
        2
    ) AS Severe_Fatal_Percentage

FROM Traffic_Summary ts

LEFT JOIN Accident_Summary a
    ON ts.Peak_Hour = a.Peak_Hour

ORDER BY
    CASE ts.Peak_Hour
        WHEN 'Peak' THEN 1
        WHEN 'Non-Peak' THEN 2
    END;
