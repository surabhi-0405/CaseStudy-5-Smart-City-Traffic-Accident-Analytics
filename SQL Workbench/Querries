    COUNT(*) AS Traffic_Observations,
    SUM(ft.Vehicle_Count) AS Total_Vehicles,
    ROUND(AVG(ft.Vehicle_Count), 2) AS Avg_Vehicle_Count,
    ROUND(AVG(ft.Average_Speed), 2) AS Avg_Speed,
    ROUND(AVG(ft.Congestion_Index), 2) AS Avg_Congestion_Index,
    SUM(CASE
        WHEN ft.Congestion_Level = 'High' THEN 1
        ELSE 0
    END) AS High_Congestion_Count
