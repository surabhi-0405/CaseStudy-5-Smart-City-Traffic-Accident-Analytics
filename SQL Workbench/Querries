-- Create Database
CREATE DATABASE IF NOT EXISTS smart_city_traffic_dw;

USE smart_city_traffic_dw;

-- ============================================================
-- 1. DIM_DATE
-- ============================================================

CREATE TABLE IF NOT EXISTS Dim_Date (
    Date_Key INT PRIMARY KEY,
    Full_Date DATE NOT NULL,
    Day INT NOT NULL,
    Day_Name VARCHAR(20) NOT NULL,
    Week INT NOT NULL,
    Month INT NOT NULL,
    Month_Name VARCHAR(20) NOT NULL,
    Quarter INT NOT NULL,
    Year INT NOT NULL,
    Is_Weekend BOOLEAN NOT NULL
);

-- ============================================================
-- 2. DIM_TIME
-- ============================================================

CREATE TABLE IF NOT EXISTS Dim_Time (
    Time_Key INT PRIMARY KEY,
    Time TIME NOT NULL,
    Hour INT NOT NULL,
    Hour_Label VARCHAR(10) NOT NULL,
    Time_Period VARCHAR(20) NOT NULL,
    Peak_Hour VARCHAR(20) NOT NULL
);

-- ============================================================
-- 3. DIM_WEATHER
-- ============================================================

CREATE TABLE IF NOT EXISTS Dim_Weather (
    Weather_Key INT PRIMARY KEY,
    Weather_Condition VARCHAR(30) NOT NULL UNIQUE
);

-- ============================================================
-- 4. DIM_ROAD_CONDITION
-- ============================================================

CREATE TABLE IF NOT EXISTS Dim_Road_Condition (
    Road_Condition_Key INT PRIMARY KEY,
    Road_Condition VARCHAR(50) NOT NULL UNIQUE
);

-- ============================================================
-- 5. DIM_VEHICLE_TYPE
-- ============================================================

CREATE TABLE IF NOT EXISTS Dim_Vehicle_Type (
    Vehicle_Type_Key INT PRIMARY KEY,
    Vehicle_Type VARCHAR(30) NOT NULL UNIQUE
);

-- ============================================================
-- 6. FACT_TRAFFIC
-- ============================================================

CREATE TABLE IF NOT EXISTS Fact_Traffic (
    Traffic_Key INT PRIMARY KEY,
    Date_Key INT NOT NULL,
    Time_Key INT NOT NULL,
    Sensor_ID VARCHAR(50) NOT NULL,
    Location VARCHAR(50) NOT NULL,
    Vehicle_Count INT NOT NULL,
    Average_Speed DECIMAL(10,2) NOT NULL,
    Congestion_Level VARCHAR(20) NOT NULL,
    Congestion_Index DECIMAL(10,4) NOT NULL,
    Congestion_Category VARCHAR(20) NOT NULL,
    Date_Time DATETIME NOT NULL,

    CONSTRAINT FK_Traffic_Date
        FOREIGN KEY (Date_Key)
        REFERENCES Dim_Date(Date_Key),

    CONSTRAINT FK_Traffic_Time
        FOREIGN KEY (Time_Key)
        REFERENCES Dim_Time(Time_Key)
);

-- ============================================================
-- 7. FACT_ACCIDENT
-- ============================================================

CREATE TABLE IF NOT EXISTS Fact_Accident (
    Accident_Key INT PRIMARY KEY,
    Date_Key INT NOT NULL,
    Time_Key INT NOT NULL,
    Accident_ID VARCHAR(50) NOT NULL,
    Location VARCHAR(50) NOT NULL,
    Weather_Key INT NOT NULL,
    Road_Condition_Key INT NOT NULL,
    Vehicle_Type_Key INT NOT NULL,
    Accident_Severity VARCHAR(20) NOT NULL,
    Accident_Severity_Score INT NOT NULL,
    Number_of_Vehicles INT NOT NULL,
    Casualties INT NOT NULL,
    Traffic_Density VARCHAR(20) NOT NULL,
    Date_Time DATETIME NOT NULL,

    CONSTRAINT FK_Accident_Date
        FOREIGN KEY (Date_Key)
        REFERENCES Dim_Date(Date_Key),

    CONSTRAINT FK_Accident_Time
        FOREIGN KEY (Time_Key)
        REFERENCES Dim_Time(Time_Key),

    CONSTRAINT FK_Accident_Weather
        FOREIGN KEY (Weather_Key)
        REFERENCES Dim_Weather(Weather_Key),

    CONSTRAINT FK_Accident_Road
        FOREIGN KEY (Road_Condition_Key)
        REFERENCES Dim_Road_Condition(Road_Condition_Key),

    CONSTRAINT FK_Accident_Vehicle
        FOREIGN KEY (Vehicle_Type_Key)
        REFERENCES Dim_Vehicle_Type(Vehicle_Type_Key)
);

