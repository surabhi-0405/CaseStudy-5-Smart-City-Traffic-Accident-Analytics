    ON ft.Time_Key = dt.Time_Key
GROUP BY dt.Time_Period
ORDER BY
    CASE dt.Time_Period
        WHEN 'Night' THEN 1
        WHEN 'Morning' THEN 2
        WHEN 'Afternoon' THEN 3
        WHEN 'Evening' THEN 4
        WHEN 'Late Evening' THEN 5
    END;
